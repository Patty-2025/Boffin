{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['userId', 'clientId']) && newData.child('userId').val() === auth.uid && newData.child('clientId').isString()"
      }
    },
    "counters": {
      "clientIds": {
        "lastId": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 100000) || (data.exists() && newData.val() === data.val() + 1))"
        }
      }
    }
    ,"studentProfiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "clientPresence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "orders": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (query.orderByChild == 'userId' && query.equalTo == auth.uid))",
      ".indexOn": ["userId", "createdAt"],
      "$orderId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || data.child('userId').val() === auth.uid || data.child('email').val() === auth.token.email)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || ((!data.exists() && newData.child('userId').val() === auth.uid) || data.child('userId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['status', 'createdAt'])"
      }
    },
    "cancelledOrders": {
      ".read": "auth != null && query.orderByChild == 'userId' && query.equalTo == auth.uid",
      ".indexOn": ["userId", "cancelledAt"],
      "$orderId": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && newData.child('userId').val() === auth.uid"
      }
    },
    "transactions": {
      ".read": "auth != null && query.orderByChild == 'userId' && query.equalTo == auth.uid",
      ".indexOn": ["userId", "createdAt"],
      "$transactionId": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && newData.child('userId').val() === auth.uid"
      }
    },
    "paymentMethods": {
      ".read": "auth != null && query.orderByChild == 'userId' && query.equalTo == auth.uid",
      ".indexOn": ["userId", "createdAt"],
      "$paymentMethodId": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && newData.child('userId').val() === auth.uid"
      }
    },
    "referralEvents": {
      ".read": "auth != null && query.orderByChild == 'referrerId' && query.equalTo == auth.uid",
      ".indexOn": ["referrerId", "referredUserId"],
      "$eventId": {
        ".read": "auth != null && data.child('referrerId').val() === auth.uid",
        ".write": "auth != null && (newData.child('referrerId').val() === auth.uid || newData.child('referredUserId').val() === auth.uid)"
      }
    },
    "grammarCheckerLimits": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chats": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$chatId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (data.child('userId').val() === auth.uid || newData.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        "messages": {
          ".read": "auth != null && (root.child('chats').child($chatId).child('userId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
          "$messageId": {
            ".write": "auth != null && (newData.child('senderId').val() === auth.uid || root.child('admins').child(auth.uid).exists())"
          }
        }
      }
    },
    "leads": {
      "$leadId": {
        ".write": "newData.child('email').isString()",
        ".read": false
      }
    },
    "resources": {
      ".read": "auth != null"
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notificationId": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
