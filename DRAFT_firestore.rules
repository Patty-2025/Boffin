rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Student Profile Rules
    match /studentProfiles/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidStudentProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidStudentProfile(request.resource.data) 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'activeModules', 'updatedAt']);
    }

    // Order Rules
    match /orders/{orderId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidOrder(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidOrder(request.resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    // Validation Blueprints
    function isValidStudentProfile(data) {
      return data.userId is string && data.userId.size() > 0 
          && data.email is string && data.email.size() > 0
          && data.emailVerified is bool;
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() > 0
          && data.taskType is string && data.taskType.size() > 0
          && data.status in ['draft', 'pending', 'paid', 'completed'];
    }
  }
}
