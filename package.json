{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node -e \"const fs=require('fs'); const path=require('path'); const buildDir='build'; fs.rmSync(buildDir,{recursive:true,force:true}); fs.mkdirSync(buildDir,{recursive:true}); for (const entry of fs.readdirSync('dist',{withFileTypes:true})) { const src=path.join('dist', entry.name); const dest=path.join(buildDir, entry.name); if (entry.isDirectory()) fs.cpSync(src, dest, { recursive: true }); else fs.copyFileSync(src, dest); }\"",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true});\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google-pay/button-react": "^3.2.1",
    "@google/genai": "^1.50.1",
    "@hookform/resolvers": "^5.2.2",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@xenova/transformers": "^2.17.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "compromise": "^14.15.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.5",
    "normalize-strings": "^1.1.1",
    "openai": "^6.34.0",
    "pluralize": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.73.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-typography": "^3.1.0",
    "vite": "^6.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
